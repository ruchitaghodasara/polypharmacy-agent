# ── Free LLM Providers ────────────────────────────────────────────────────────
GEMINI_API_KEY=           # get from aistudio.google.com (free tier available)
GROQ_API_KEY=             # get from console.groq.com (free tier available)
CEREBRAS_API_KEY=         # get from inference.cerebras.ai (free tier available)

# Active provider + fallback (used by llm_config.get_llm())
# Options: gemini | groq | cerebras | ollama
LLM_PROVIDER=gemini
LLM_FALLBACK=groq

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Copy these from your Upstash console → database → REST API section
UPSTASH_REDIS_URL=rediss://:your-token@your-endpoint.upstash.io:6380
# Alternatively, split into host/port/password for redis-py:
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6380
REDIS_PASSWORD=your-upstash-token
REDIS_SSL=true

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# For local persistent storage, set the directory path.
# Leave CHROMA_HOST empty to use local mode.
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_HOST=
CHROMA_PORT=8000

# ── FastAPI Backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=change-me-to-a-random-secret

# ── Agent Tuning ──────────────────────────────────────────────────────────────
# Maximum retries for LLM calls via tenacity
LLM_MAX_RETRIES=3
# Minimum severity score (0-10) before raising an alert
ALERT_SEVERITY_THRESHOLD=7

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
