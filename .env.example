# No API keys needed — fully offline via Ollama
# Install Ollama: https://ollama.com
# Pull the model: ollama pull llama3.1:8b
# Start the server: ollama serve

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash free tier: https://upstash.com  (or run Redis locally with: docker run -p 6379:6379 redis)
UPSTASH_REDIS_URL=rediss://:your-token@your-endpoint.upstash.io:6380
# Alternatively, split into host/port/password for redis-py:
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6380
REDIS_PASSWORD=your-upstash-token
REDIS_SSL=true

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ── FastAPI Backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=change-me-to-a-random-secret

# ── Agent Tuning ──────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=3
ALERT_SEVERITY_THRESHOLD=7

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
